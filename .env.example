# Connection string for the MongoDB Atlas cluster that stores the catalog, matches, and issue cache.
# Create a cluster and database user at https://www.mongodb.com/atlas and copy the SRV URI.
MONGODB_URI=

# Database name in that cluster. Use fossfinder unless you have a reason to change it.
MONGODB_DB=fossfinder

# Google Gemini API key used to read the resume and rank repositories.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model id. Leave empty to use gemini-3.8-flash.
# Model ids: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=

# GitHub token for starter-issue lookup. Public repository read access is enough.
# Optional. Without it GitHub allows about 60 REST requests per hour (about 10 per minute on search),
# and one match can make up to 15 calls. Results are cached in Atlas for about an hour.
# Create a classic token at https://github.com/settings/tokens
GITHUB_TOKEN=
PUBLIC_URL=https://fossfinder.work
